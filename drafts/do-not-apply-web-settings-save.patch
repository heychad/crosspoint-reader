diff --git a/test/quick_actions/test_web_save_failure.py b/test/quick_actions/test_web_save_failure.py
new file mode 100644
index 00000000..21aab547
--- /dev/null
+++ b/test/quick_actions/test_web_save_failure.py
@@ -0,0 +1,82 @@
+"""Check web settings save failures and retry against the production handlers."""
+from pathlib import Path
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[2]
+server = (root / 'src/network/CrossPointWebServer.cpp').read_text()
+start = server.index('  const bool settingsSaved = SETTINGS.saveToFile();')
+end = server.index('  LOG_DBG("WEB", "Applied %d setting(s)"', start)
+failure_handler = server[start:end]
+page = (root / 'src/network/html/SettingsPage.html').read_text()
+start = page.index('  async function saveSettings() {')
+end = page.index('  // --- Wi-Fi Network Management ---', start)
+save_settings = page[start:end]
+
+cpp = r'''
+#include <cassert>
+#include <string>
+struct Settings { bool result; bool saveToFile() const { return result; } } SETTINGS;
+struct KOReader { bool result; bool saveToFile() const { return result; } } KOREADER_STORE;
+#define STR_SETTINGS_PARTIAL_SAVE_FAILED 1
+#define tr(id) "Some settings may not have saved. Check the SD card and retry."
+struct Server { int code=0; std::string message; void send(int c,const char*,const char* m){code=c;message=m;} } instance;
+Server* server=&instance;
+bool handle(bool koReaderTouched) {
+''' + failure_handler.replace('    return;', '    return false;') + r'''
+ return true;
+}
+int main(){
+ SETTINGS.result=false;KOREADER_STORE.result=true;assert(!handle(false));assert(instance.code==500);
+ assert(instance.message.find("retry")!=std::string::npos);
+ SETTINGS.result=true;KOREADER_STORE.result=false;instance.code=0;assert(!handle(true));assert(instance.code==500);
+ KOREADER_STORE.result=true;instance.code=0;assert(handle(true));assert(instance.code==0);
+}
+'''
+js = r'''
+const assert = require('assert');
+const button = {disabled:false, textContent:''};
+global.document = {getElementById: () => button};
+const allSettings=[{key:'brightness'}];
+let originalValues={brightness:1};
+let failedSaveKeys = new Set();
+const quickActionKeys=['readerUpTap','readerDownTap'];
+let selected={brightness:2}, posted=[];
+function getValue(setting) { return selected[setting.key]; }
+let toast='';
+function showWebToast(text) { toast=text; }
+console.error=()=>{};
+let fail=true;
+global.fetch=async(url, options)=> { posted.push(JSON.parse(options.body)); return fail ? {ok:false,text:async()=> 'Could not save; retry.'} : {ok:true}; };
+''' + save_settings + r'''
+(async()=>{
+ await saveSettings();
+ assert.equal(button.disabled,false);
+ assert.equal(originalValues.brightness,1);
+ assert.ok(toast.includes('retry'));
+ selected.brightness=1;
+ fail=false;
+ await saveSettings();
+ assert.deepEqual(posted[1],{brightness:1});
+ assert.equal(button.disabled,true);
+ assert.equal(originalValues.brightness,1);
+ allSettings.push({key:'readerUpTap'}, {key:'readerDownTap'});
+ originalValues.readerUpTap=21; originalValues.readerDownTap=0;
+ selected.readerUpTap=21; selected.readerDownTap=21;
+ fail=true;
+ await saveSettings();
+ selected.readerDownTap=0;
+ fail=false;
+ await saveSettings();
+ assert.equal(posted[3].readerUpTap,21);
+ assert.equal(posted[3].readerDownTap,0);
+})().catch(e=>{process.stderr.write(String(e));process.exitCode=1;});
+'''
+with tempfile.TemporaryDirectory() as directory:
+    directory = Path(directory)
+    (directory / 'test.cpp').write_text(cpp)
+    subprocess.run(['c++', '-std=c++17', '-Wall', '-Wextra', '-Werror', str(directory / 'test.cpp'),
+                    '-o', str(directory / 'test')], check=True)
+    subprocess.run([str(directory / 'test')], check=True)
+    subprocess.run(['node', '-e', js], check=True)
+print('Settings web save failure and retry checks passed')
