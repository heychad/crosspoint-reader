+
+bool ExFatFile::smallSingleClusterChain() {
+  if (!isFile() || !fileSize() || !m_dataLength || m_dataLength > 512 || m_firstCluster < 2) return false;
+  if (!firstClusterMarkedAllocated()) return false;
+  if (isContiguous()) return true;
+  Cluster_t next;
+  return m_vol->fatGet(m_firstCluster, &next) == 0;
+}
+
+bool ExFatFile::settingsSingleClusterChain() {
+  if (!isFile() || !fileSize() || !m_dataLength || m_dataLength > 32768 || m_firstCluster < 2) return false;
+  const uint8_t shift = m_vol->bytesPerClusterShift();
+  if (shift >= 63 || m_dataLength > (uint64_t{1} << shift) ||
+      m_firstCluster - 2 >= m_vol->clusterCount()) return false;
+  if (!firstClusterMarkedAllocated()) return false;
+  if (isContiguous()) return true;
+  Cluster_t next;
+  return m_vol->fatGet(m_firstCluster, &next) == 0;
+}
+
+bool ExFatFile::firstClusterMarkedAllocated() {
+  if (!isFile() || m_firstCluster < 2 || m_firstCluster - 2 >= m_vol->clusterCount()) return false;
+  const uint32_t bit = m_firstCluster - 2;
+  const uint8_t shift = m_vol->bytesPerSectorShift();
+  const Sector_t sector = m_vol->clusterHeapStartSector() + (bit >> (shift + 3));
+  const uint8_t* data = m_vol->bitmapCachePrepare(sector, FsCache::CACHE_FOR_READ);
+  return data && (data[(bit >> 3) & ((uint32_t{1} << shift) - 1)] & (uint8_t{1} << (bit & 7)));
+}
+
+bool ExFatFile::settingsClusterList(Cluster_t* out, size_t capacity, size_t* count) {
+  if (!out || !count || !isFile() || !m_dataLength || m_dataLength > (capacity > 64 ? 262144 : 32768) ||
+      m_validLength != m_dataLength || m_firstCluster < 2) return false;
+  const uint8_t shift = m_vol->bytesPerClusterShift();
+  if (shift >= 63) return false;
+  const uint64_t clusterBytes = uint64_t{1} << shift;
+  const size_t expected = (m_dataLength + clusterBytes - 1) / clusterBytes;
+  if (!expected || expected > capacity || expected > 512) return false;
+  Cluster_t current = m_firstCluster;
+  for (size_t i = 0; i < expected; ++i) {
+    if (current < 2 || current - 2 >= m_vol->clusterCount()) return false;
+    for (size_t j = 0; j < i; ++j) if (out[j] == current) return false;
+    const uint32_t bit = current - 2;
+    const uint8_t sectorShift = m_vol->bytesPerSectorShift();
+    const Sector_t sector = m_vol->clusterHeapStartSector() + (bit >> (sectorShift + 3));
+    const uint8_t* data = m_vol->bitmapCachePrepare(sector, FsCache::CACHE_FOR_READ);
+    if (!data || !(data[(bit >> 3) & ((uint32_t{1} << sectorShift) - 1)] & (uint8_t{1} << (bit & 7)))) return false;
+    out[i] = current;
+    if (isContiguous()) {
+      if (i + 1 < expected) { if (current == UINT32_MAX) return false; ++current; }
+    } else {
+      Cluster_t next = 0;
+      const int result = m_vol->fatGet(current, &next);
+      if (i + 1 == expected) { if (result != 0) return false; }
+      else { if (result != 1) return false; current = next; }
+    }
+  }
+  *count = expected;
+  return true;
+}
