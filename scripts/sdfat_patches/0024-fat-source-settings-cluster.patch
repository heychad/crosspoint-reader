+
+bool FatFile::settingsSingleClusterChain() {
+  if (!isFile() || !fileSize() || fileSize() > 32768 || m_firstCluster < 2) return false;
+  const uint8_t shift = m_vol->bytesPerClusterShift();
+  if (shift >= 63 || uint64_t(fileSize()) > (uint64_t{1} << shift) ||
+      m_firstCluster - 2 >= m_vol->clusterCount()) return false;
+  Cluster_t next;
+  bool strictEoc = false;
+  return m_vol->fatGet(m_firstCluster, &next, &strictEoc) == 0 && strictEoc;
+}
