+
+bool FatFile::settingsSingleClusterChain() {
+  if (!isFile() || !fileSize() || fileSize() > 32768 || m_firstCluster < 2) return false;
+  const uint8_t shift = m_vol->bytesPerClusterShift();
+  if (shift >= 63 || uint64_t(fileSize()) > (uint64_t{1} << shift) ||
+      m_firstCluster - 2 >= m_vol->clusterCount()) return false;
+  Cluster_t next;
+  bool strictEoc = false;
+  return m_vol->fatGet(m_firstCluster, &next, &strictEoc) == 0 && strictEoc;
+}
+
+bool FatFile::settingsClusterList(Cluster_t* out, size_t capacity, size_t* count) {
+  // Larger buffers are used only for clipping-store recovery on X4 Pro.
+  const bool large = capacity > 512;
+  const size_t byteLimit = large ? 5U * 1024U * 1024U : (capacity > 64 ? 262144U : 32768U);
+  if (!out || !count || !isFile() || !fileSize() || fileSize() > byteLimit || m_firstCluster < 2) return false;
+  const uint8_t shift = m_vol->bytesPerClusterShift();
+  if (shift >= 63) return false;
+  const uint64_t clusterBytes = uint64_t{1} << shift;
+  const size_t expected = (uint64_t(fileSize()) + clusterBytes - 1) / clusterBytes;
+  if (!expected || expected > capacity || expected > (large ? 10240U : 512U)) return false;
+  Cluster_t current = m_firstCluster;
+  for (size_t i = 0; i < expected; ++i) {
+    if (current < 2 || current - 2 >= m_vol->clusterCount()) return false;
+    // Every chain below must terminate at exactly its expected length. A
+    // cycle cannot reach EOC. Large-list callers also check sorted IDs.
+    if (!large) {
+      for (size_t j = 0; j < i; ++j) if (out[j] == current) return false;
+    }
+    out[i] = current;
+    Cluster_t next = 0;
+    bool strictEoc = false;
+    const int result = m_vol->fatGet(current, &next, &strictEoc);
+    if (i + 1 == expected) { if (result != 0 || !strictEoc) return false; }
+    else { if (result != 1) return false; current = next; }
+  }
+  *count = expected;
+  return true;
+}
