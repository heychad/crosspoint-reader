--- a/src/FsLib/FsVolume.h
+++ b/src/FsLib/FsVolume.h
@@ -158,9 +158,11 @@
   // Return 1 when the file and overhead fit, 0 for insufficient space,
   // and -1 when the mounted volume's allocation map cannot be read.
-  int8_t allocationRoom(uint32_t fileBytes, uint8_t extraClusters) const {
+  int8_t allocationRoom(uint32_t fileBytes, uint32_t extraClusters) const {
     uint32_t clusterBytes = m_fVol ? uint32_t(m_fVol->bytesPerSector()) * m_fVol->sectorsPerCluster()
                                    : m_xVol ? m_xVol->bytesPerCluster() : 0;
     if (!clusterBytes) return -1;
-    uint32_t needed = extraClusters + (fileBytes ? 1 + (fileBytes - 1) / clusterBytes : 0);
+    const uint32_t fileClusters = fileBytes ? 1 + (fileBytes - 1) / clusterBytes : 0;
+    if (extraClusters > UINT32_MAX - fileClusters) return 0;
+    const uint32_t needed = extraClusters + fileClusters;
     return m_fVol ? m_fVol->hasFreeClusters(needed) : m_xVol->hasFreeClusters(needed);
   }
